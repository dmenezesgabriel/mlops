#!/usr/bin/env python3
"""Local-hosting entry point: gunicorn process serving the SDK container."""

import os
import sys

sys.path.insert(0, "/opt/ml/serve")

from gunicorn.app.base import BaseApplication

from serve_app import create_app


class GunicornApplication(BaseApplication):
    def __init__(self, app, options) -> None:
        self.application = app
        self.options = options
        super().__init__()

    def load_config(self) -> None:
        for key, value in self.options.items():
            self.cfg.set(key, value)

    def load(self):
        return self.application


def main() -> None:
    port = os.environ.get("SAGEMAKER_BIND_TO_PORT", "8080")
    address = os.environ.get("SAGEMAKER_BIND_ADDRESS", "0.0.0.0")
    GunicornApplication(
        create_app(), {"bind": f"{address}:{port}", "workers": 1, "timeout": 60}
    ).run()


if __name__ == "__main__":
    main()